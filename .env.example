# ViralLoop Environment Configuration

# Backend Server
PORT=8000
HOST=0.0.0.0
DEBUG=True

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4
# Fallback models: gemma:2b, qwen2.5:3b
OLLAMA_TIMEOUT=90.0

# YouTube Publishing Mode
# Options: "simulated" (instant mock publishing with simulated growth metrics)
#          "live" (uses official YouTube Data API v3 OAuth)
YOUTUBE_MODE=simulated
YOUTUBE_CLIENT_SECRETS_FILE=backend/client_secrets.json
YOUTUBE_TOKEN_FILE=backend/token.json

# Text to Speech Voice (Edge-TTS)
# Options: en-US-ChristopherNeural, en-US-JennyNeural, en-US-GuyNeural, en-GB-SoniaNeural
TTS_VOICE=en-US-ChristopherNeural
TTS_RATE=+15%
